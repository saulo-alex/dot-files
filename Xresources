! xterm
xterm_dark.termName: xterm-256color
xterm_dark.ttyModes: erase ^?
!xterm.vt100.background: #000000
!xterm.vt100.foreground: #b2b2b2
!xterm.vt100.faceName: Hack:style=Bold:antialias=true
!xterm.vt100.faceName: Iosevka Term:style=Semibold:antialias=true
!xterm.vt100.faceName: IBM Plex Mono:style=Medium:antialias=true
xterm_dark.vt100.faceName: JetBrains Mono:style=Bold:antialias=true
!xterm.vt100.faceName: Noto Sans Mono:style=Medium:antialias=true
!xterm.vt100.faceName: Adwaita Mono:style=Medium:antialias=true
!xterm.vt100.faceName: Inconsolata:style=Medium:antialias=true
!xterm.vt100.faceName: Cascadia Code:style=SemiBold:antialias=true
!xterm.vt100.faceName: Monoide:style=Medium:antialias=true
xterm_dark.vt100.faceSize: 8
xterm_dark.vt100.utf8: 1
xterm_dark.vt100.utf8Title: true
xterm_dark.vt100.forceBoxChars: true
xterm_dark.vt100.allowBoldFonts: false
xterm_dark.vt100.alternateScroll: true
xterm_dark.vt100.multiScroll: true
xterm_dark.vt100.scrollTtyOutput: false
xterm_dark.vt100.scrollKey: true
xterm_dark.vt100.jumpScroll: true
xterm_dark.vt100.fastScroll: true
xterm_dark.vt100.geometry: 100x25
xterm_dark.vt100.locale: true
xterm_dark.vt100.metaSendsEscape: true
xterm_dark.vt100.backarrowKey: false
xterm_dark.vt100.saveLines: 8192
xterm_dark.vt100.selectToClipboard: true
! permite selecionar com mouse no vim
xterm_dark.vt100.allowSendEvents: false
xterm_dark.vt100.scrollBar: false
xterm_dark.vt100.rightScrollBar: true
xterm_dark.vt100.bellIsUrgent: true
xterm_dark.vt100.faceSize1: 8
xterm_dark.vt100.faceSize2: 9
xterm_dark.vt100.faceSize3: 10
xterm_dark.vt100.faceSize4: 12
xterm_dark.vt100.faceSize5: 14
xterm_dark.vt100.faceSize6: 16
! atalhos
xterm_dark.vt100.translations: #override \
    Ctrl Shift <Key>Up: scroll-back(1) \n\
    Ctrl Shift <Key>Down: scroll-forw(1) \n\
    Ctrl Shift <Key>Home: scroll-to(begin) \n\
    Ctrl Shift <Key>End: scroll-to(end) \n\
    Ctrl Shift <Key>+: larger-vt-font() \n\
    Ctrl Shift <Key>-: smaller-vt-font() \n\
    Ctrl <Btn1Down>: ignore() \n\
    Ctrl <Btn2Down>: ignore() \n\
    Ctrl <Btn3Down>: ignore() \n\
    Alt <Btn1Down>: popup-menu(mainMenu) \n\
    Alt <Btn2Down>: popup-menu(vtMenu) \n\
    Alt <Btn3Down>: popup-menu(fontMenu)
xterm_dark.vt100.cursorColor: .XtDefaultForeground
xterm_dark.vt100.dynamicColors: true
xterm_dark.vt100.highlightColorMode: true
xterm_dark.vt100.alwaysHighlight: true
xterm_dark.vt100.cursorBlink: true

!! Theme based on xterm with high contrast
xterm_dark.vt100.foreground:   #d9d9d9
xterm_dark.vt100.background:   #020202
! black
xterm_dark.vt100.color0:  #000000
xterm_dark.vt100.color8:  #888888
! red
xterm_dark.vt100.color1:  #ff2222 
xterm_dark.vt100.color9:  #ff7777 
! green
xterm_dark.vt100.color2:  #22ff22 
xterm_dark.vt100.color10: #88ff88 
! yellow
xterm_dark.vt100.color3:  #ffff00
xterm_dark.vt100.color11: #cccc22
! blue
xterm_dark.vt100.color4:  #2222ee
xterm_dark.vt100.color12: #8888ee
! magenta
xterm_dark.vt100.color5:  #ff00ff
xterm_dark.vt100.color13: #dd77dd
! cyan
xterm_dark.vt100.color6:  #00ffff
xterm_dark.vt100.color14: #99ffff
! white
xterm_dark.vt100.color7:  #a0a0a0 
xterm_dark.vt100.color15: #ffffff 


